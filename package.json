{
  "name": "bare-win-ui",
  "version": "0.3.5",
  "description": "WinUI bindings and runtime for Bare",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./runtime": "./runtime.js",
    "./*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "runtime.js",
    "binding.cc",
    "binding.js",
    "CMakeLists.txt",
    "cmake",
    "lib",
    "prebuilds"
  ],
  "addon": true,
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "bare-native-test --runtime bare-win-ui/runtime test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holepunchto/bare-win-ui.git"
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/holepunchto/bare-win-ui/issues"
  },
  "homepage": "https://github.com/holepunchto/bare-win-ui#readme",
  "dependencies": {
    "bare-events": "^2.8.2",
    "bare-winrt-registry": "^0.1.0",
    "require-asset": "^1.1.0"
  },
  "peerDependencies": {
    "bare-build": "^1.0.0"
  },
  "devDependencies": {
    "bare-animation-frame": "^0.1.0",
    "bare-native-test": "^0.1.0",
    "bare-tap": "^1.1.0",
    "bare-win-ui": "file:.",
    "cmake-bare": "^1.6.5",
    "cmake-fetch": "^1.4.0",
    "lunte": "^1.8.0",
    "prettier": "^3.4.1",
    "prettier-config-holepunch": "^2.0.0"
  }
}
